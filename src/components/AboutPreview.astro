---
---

<section class="about-preview" aria-labelledby="about-preview-title">
  <img
    class="about-preview__image"
    src="/images/about/f1-photo-10.jpg"
    alt="Vogue Architech long architectural building elevation with sky and lawn"
    width="1920"
    height="1080"
    loading="lazy"
    decoding="async"
  />
  <div class="about-preview__gradient" aria-hidden="true"></div>

  <button
    class="about-preview__button"
    type="button"
    aria-label="About us"
  >
    ABOUT US
    <svg class="about-preview__button-arrow" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M6 12 h12 M14 6 l4 6 -4 6"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="square"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <div class="about-preview__content">
  <div class="about-preview__statistics">
    <div class="about-preview__stat">
      <span class="about-preview__metric-value">
        <span class="about-preview__metric-number">50</span>
        <span class="about-preview__metric-plus">+</span>
      </span>
      <span class="about-preview__label">Projects done</span>
    </div>
    <div class="about-preview__stat">
      <span class="about-preview__metric-value">
        <span class="about-preview__metric-number">5</span>
        <span class="about-preview__metric-plus">+</span>
      </span>
      <span class="about-preview__label">Years of experience</span>
    </div>
    <div class="about-preview__stat">
      <span class="about-preview__metric-value">
        <span class="about-preview__metric-number">10</span>
        <span class="about-preview__metric-plus">+</span>
      </span>
      <span class="about-preview__label">Design honors</span>
    </div>
  </div>
  <p class="about-preview__statement">
    <span class="about-preview__statement-line">
      We blend <span class="about-preview__statement-accent">creativity</span>
    </span>
    <span class="about-preview__statement-line">
      with <span class="about-preview__statement-accent">world class design</span>
    </span>
    <span class="about-preview__statement-line">
      to build the <span class="about-preview__statement-accent">best living spaces</span>
    </span>
  </p>
  </div>
</section>
