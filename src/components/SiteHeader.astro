---
---
<header class="site-header" data-site-header>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="site-header__top-row" data-header-top>
    <a class="brand-lockup" href="/" aria-label="Vogue Architech home">
      <img
        class="brand-logo"
        src="/images/brand/vogue-architech-logo.png"
        alt="Vogue Architech"
        width="1080"
        height="1080"
        loading="eager"
      />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Open navigation menu"
      data-menu-toggle
    >
      <span class="menu-toggle__line menu-toggle__line--top" aria-hidden="true"></span>
      <span class="menu-toggle__line menu-toggle__line--mid" aria-hidden="true"></span>
      <span class="menu-toggle__line menu-toggle__line--bot" aria-hidden="true"></span>
    </button>
  </div>

  <div class="site-header__navigation-panel">
    <div class="nav-inner">
      <div class="nav-rule" aria-hidden="true"></div>
      <nav class="site-navigation" id="primary-navigation" aria-label="Primary navigation" data-site-nav aria-hidden="true">
        <a class="site-navigation__item is-active" href="/" aria-current="page">Home</a>
        <button class="site-navigation__item" type="button" aria-disabled="true" data-nav-inactive>About us</button>
        <button class="site-navigation__item" type="button" aria-disabled="true" data-nav-inactive>Our services</button>
        <button class="site-navigation__item" type="button" aria-disabled="true" data-nav-inactive>Portfolio</button>
        <button class="site-navigation__item" type="button" aria-disabled="true" data-nav-inactive>Contact us</button>
      </nav>
    </div>
  </div>
</header>

<script>
  (function () {
    const header = document.querySelector('[data-site-header]');
    const toggle = document.querySelector('[data-menu-toggle]');
    const nav = document.querySelector('[data-site-nav]');
    if (!header || !toggle || !nav) return;

    function open() {
      header.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close navigation menu');
      nav.setAttribute('aria-hidden', 'false');
      document.body.classList.add('nav-is-open');
    }

    function close() {
      header.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      nav.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('nav-is-open');
    }

    toggle.addEventListener('click', function () {
      if (header.classList.contains('is-open')) close(); else open();
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && header.classList.contains('is-open')) close();
    });

    document.addEventListener('click', function (event) {
      if (!header.classList.contains('is-open')) return;
      if (!header.contains(event.target)) close();
    });

    nav.querySelectorAll('.site-navigation__item').forEach(function (item) {
      item.addEventListener('click', function (event) {
        if (item.getAttribute('aria-disabled') === 'true') event.preventDefault();
        close();
      });
    });
  })();
</script>
