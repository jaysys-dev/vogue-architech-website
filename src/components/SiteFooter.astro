---
import { homepageAssets, isHomepageAssetAvailable } from '../data/homepage-assets.js';

const hasLogo = isHomepageAssetAvailable(homepageAssets.logo);
---

<footer class="site-footer">
  <div class="site-footer__main">
    <div class="site-footer__identity">
      <a class="brand-lockup brand-lockup--footer" href="/" aria-label="Vogue Architech home">
        {hasLogo ? <img class="brand-logo" src={homepageAssets.logo} alt="Vogue Architech" /> : <span class="brand-fallback">Vogue Architech</span>}
      </a>
      <p>Architecture-led development and design-build, shaped around the way people live.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <span class="footer-nav__label">Explore</span>
      <a href="/">Home</a>
      <button type="button" data-toast-trigger>About</button>
      <button type="button" data-toast-trigger>Services</button>
      <button type="button" data-toast-trigger>Projects</button>
      <button type="button" data-toast-trigger>Contact</button>
    </nav>

    <div class="site-footer__place">
      <span class="footer-nav__label">Based in</span>
      <p>Kampala, Uganda</p>
    </div>
  </div>

  <div class="site-footer__bottom">
    <span>© {new Date().getFullYear()} Vogue Architech</span>
    <span class="site-footer__motto">Thoughtful Developments. Elevated Living.</span>
  </div>
</footer>
