---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout>
  <SiteHeader />

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-heading">
      <img
        class="hero__image"
        src="/images/hero/architectural-study-placeholder.svg"
        alt="Architectural study placeholder showing a quiet modernist façade, open arcade, and limestone courtyard."
        fetchpriority="high"
        width="2200"
        height="1500"
      />
      <div class="hero__veil" aria-hidden="true"></div>

      <div class="hero__content page-gutter">
        <p class="eyebrow hero__eyebrow">Architecture <span>·</span> Development <span>·</span> Design &amp; Build</p>
        <h1 id="hero-heading">Spaces for a<br /><em>Better Tomorrow</em></h1>
        <p class="hero__intro">
          Thoughtful developments shaped by architectural clarity, technical intelligence, and the way people live.
        </p>
        <div class="hero__actions">
          <a class="button button--light" href="#selected-work">
            Explore Our Work <span class="button__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="text-link text-link--light" href="#practice">Discover the Practice <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <div class="hero__caption" aria-label="Placeholder visual">
        <span>Architectural study</span>
        <span>Placeholder visual</span>
      </div>
      <a class="scroll-cue" href="#practice" aria-label="Scroll to discover the practice">
        <span class="scroll-cue__line" aria-hidden="true"></span>
        <span>Scroll to explore</span>
      </a>
    </section>

    <section class="statement section-pad" id="practice" aria-labelledby="statement-heading">
      <div class="statement__aside">
        <span class="section-index">01 / The practice</span>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="statement__body">
        <h2 id="statement-heading">
          <span>We design more than structures.</span>
          <span><em>We shape places with purpose.</em></span>
        </h2>
        <div class="statement__lower">
          <span class="statement__label">Architecture-led practice</span>
          <p>
            Vogue Architech brings architectural thinking, engineering intelligence, and real-estate development
            together to create enduring spaces.
          </p>
        </div>
      </div>
    </section>

    <section class="practice section-pad section-pad--top" id="services" aria-labelledby="practice-heading">
      <div class="section-heading">
        <div>
          <span class="section-index">02 / What we do</span>
          <h2 id="practice-heading">A considered<br /><em>way of building.</em></h2>
        </div>
        <p>Three connected disciplines. One thoughtful approach to the built environment.</p>
      </div>

      <div class="practice-list">
        <article class="practice-row">
          <span class="practice-row__number">01</span>
          <div class="practice-row__copy">
            <h3>Architecture</h3>
            <p>Purposeful spaces shaped through proportion, context, material, and human experience.</p>
          </div>
          <div class="practice-study practice-study--architecture" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
        </article>
        <article class="practice-row">
          <span class="practice-row__number">02</span>
          <div class="practice-row__copy">
            <h3>Real Estate Development</h3>
            <p>Thoughtful developments created for lasting value, relevance, and quality of life.</p>
          </div>
          <div class="practice-study practice-study--development" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </article>
        <article class="practice-row">
          <span class="practice-row__number">03</span>
          <div class="practice-row__copy">
            <h3>Design &amp; Build</h3>
            <p>One coordinated process connecting design intelligence with disciplined execution.</p>
          </div>
          <div class="practice-study practice-study--build" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </article>
      </div>
    </section>

    <section class="work section-pad" id="selected-work" aria-labelledby="work-heading">
      <div class="section-heading section-heading--work">
        <div>
          <span class="section-index">03 / Selected work</span>
          <h2 id="work-heading">Selected <em>Work</em></h2>
        </div>
        <p>Architectural studies are shown in place of verified project photography. Project details will be added when confirmed.</p>
      </div>

      <div class="work-grid">
        <article class="project project--wide">
          <figure class="project__visual">
            <img
              src="/images/projects/project-01-study-placeholder.svg"
              alt="Abstract residential architectural study placeholder with a stone colonnade and layered courtyard volumes."
              width="1400"
              height="960"
              loading="lazy"
            />
            <figcaption class="project__visual-note">Placeholder architectural study</figcaption>
            <span class="project__index">01</span>
          </figure>
          <div class="project__meta">
            <div><h3>Project 01</h3><span>Residential</span></div>
            <span class="project__status">Project details to follow</span>
          </div>
        </article>

        <article class="project project--narrow">
          <figure class="project__visual">
            <img
              src="/images/projects/project-02-study-placeholder.svg"
              alt="Abstract commercial architectural study placeholder with a shaded façade and vertical fins."
              width="1000"
              height="1150"
              loading="lazy"
            />
            <figcaption class="project__visual-note">Placeholder architectural study</figcaption>
            <span class="project__index">02</span>
          </figure>
          <div class="project__meta">
            <div><h3>Project 02</h3><span>Commercial</span></div>
            <span class="project__status">Project details to follow</span>
          </div>
        </article>

        <article class="project project--offset">
          <figure class="project__visual">
            <img
              src="/images/projects/project-03-study-placeholder.svg"
              alt="Abstract mixed-use architectural study placeholder with interlocking limestone volumes and a planted edge."
              width="1200"
              height="850"
              loading="lazy"
            />
            <figcaption class="project__visual-note">Placeholder architectural study</figcaption>
            <span class="project__index">03</span>
          </figure>
          <div class="project__meta">
            <div><h3>Project 03</h3><span>Mixed Use</span></div>
            <span class="project__status">Project details to follow</span>
          </div>
        </article>
      </div>
    </section>

    <section class="philosophy section-pad" aria-labelledby="philosophy-heading">
      <div class="philosophy__geometry" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>
      <div class="philosophy__intro">
        <span class="section-index section-index--light">04 / Design philosophy</span>
        <h2 id="philosophy-heading">Beauty balanced<br />with <em>intelligence.</em></h2>
      </div>
      <div class="principles">
        <div class="principle"><span>01</span><p>Purpose before excess</p></div>
        <div class="principle"><span>02</span><p>Beauty supported by logic</p></div>
        <div class="principle"><span>03</span><p>Details that strengthen the whole</p></div>
      </div>
      <p class="philosophy__note">A point of view for every decision, from the first line to the final detail.</p>
    </section>

    <section class="approach section-pad" aria-labelledby="approach-heading">
      <div class="section-heading section-heading--approach">
        <div>
          <span class="section-index">05 / The approach</span>
          <h2 id="approach-heading">Clarity at<br /><em>every step.</em></h2>
        </div>
        <p>A connected process keeps purpose and execution in view from beginning to end.</p>
      </div>
      <ol class="approach-steps">
        <li><span class="approach-steps__number">01</span><span class="approach-steps__name">Understand</span></li>
        <li><span class="approach-steps__number">02</span><span class="approach-steps__name">Define</span></li>
        <li><span class="approach-steps__number">03</span><span class="approach-steps__name">Design</span></li>
        <li><span class="approach-steps__number">04</span><span class="approach-steps__name">Deliver</span></li>
      </ol>
    </section>

    <section class="closing section-pad" aria-labelledby="closing-heading">
      <div class="closing__index"><span class="section-index">06 / Begin a conversation</span></div>
      <div class="closing__content">
        <h2 id="closing-heading">Let’s shape<br /><em>what comes next.</em></h2>
        <div class="closing__action">
          <p>Begin a conversation about your project, place, or development.</p>
          <button class="button button--dark" type="button" data-toast-trigger>
            Start a Conversation <span class="button__arrow" aria-hidden="true">↗</span>
          </button>
        </div>
      </div>
      <span class="closing__rule" aria-hidden="true"></span>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
