---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import AboutPreview from '../components/AboutPreview.astro';
import OurServices from '../components/OurServices.astro';
---

<BaseLayout>
  <SiteHeader />

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-heading">
      <img
        class="hero__image"
        src="/images/hero/vogue-architech-hero.jpg"
        alt=""
        fetchpriority="high"
        width="2000"
        height="1333"
        loading="eager"
      />
      <div class="hero__gradient" aria-hidden="true"></div>

      <div class="hero__statement">
        <div class="hero__statement-line">THOUGHTFUL</div>
        <div class="hero__statement-line">DEVELOPMENTS</div>
        <div class="hero__statement-line hero__statement-line--gold">ELEVATED LIVING</div>
      </div>

      <div class="hero__brand">VOGUE ARCHITECH</div>
    </section>

    <FeaturedWork />
    <AboutPreview />
    <OurServices />
  </main>
</BaseLayout>
